<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CodexTPSTray</RootNamespace>
    <AssemblyName>CodexTPSTray</AssemblyName>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexTPSCore\CodexTPSCore.csproj" />
    <InternalsVisibleTo Include="CodexTPSTray.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="../../../Resources/AppIcon.png">
      <Link>Resources/AppIcon.png</Link>
    </Resource>
  </ItemGroup>

</Project>
