<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CodexTPSTray</RootNamespace>
    <AssemblyName>CodexTPSTray</AssemblyName>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      Suppress WinForms high-DPI manifest warning WFO0003: in this mixed WPF + WinForms
      application, the entry point is WPF App.xaml and DPI awareness is declared authoritatively
      in app.manifest (PerMonitorV2). WinForms' auto-generated manifest/config is not used.
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Version>0.3.3</Version>
    <AssemblyVersion>0.3.3.0</AssemblyVersion>
    <FileVersion>0.3.3.0</FileVersion>
    <InformationalVersion>0.3.3</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexTPSCore\CodexTPSCore.csproj" />
    <InternalsVisibleTo Include="CodexTPSTray.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="../../../Resources/AppIcon.png">
      <Link>Resources/AppIcon.png</Link>
    </Resource>
  </ItemGroup>

</Project>
